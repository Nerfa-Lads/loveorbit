# Copy to .env and fill in. NEVER commit real .env.
# Neon connection string (or any Postgres). Example:
#   postgresql://user:pass@ep-xxx.neon.tech/loveorbit?sslmode=require
DATABASE_URL=postgresql://user:password@ep-host.neon.tech/loveorbit?sslmode=require

# Random long string for signing JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-please

# Port the API listens on
PORT=4000

# Where uploaded photos are served from (defaults to http://localhost:4000/uploads)
PUBLIC_BASE_URL=http://localhost:4000
